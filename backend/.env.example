# Local development. Copy to .env and adjust.
DATABASE_URL=postgresql+psycopg://localhost/rubriciq
ENV=development

# Auth
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Superadmin seed (only consulted on first boot when no superadmin exists)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me

# Email (leave RESEND_API_KEY empty in dev to use the no-op email client)
RESEND_API_KEY=
RESEND_FROM_EMAIL=RubricIQ <noreply@rubriciq.com>

# URL the activation email links to
FRONTEND_BASE_URL=http://localhost:5173

# CORS allow list. Defaults to the dev ports; production should be set to
# https://app.rubriciq.com (comma-separated for multiple origins).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Artifact storage. ARTIFACT_DIR is /data/artifacts on Railway (mounted volume);
# locally point it at any writable directory.
ARTIFACT_DIR=./var/artifacts
ARTIFACT_SIGNING_SECRET=change-me-to-a-64-char-random-string-distinct-from-jwt
MAX_FILE_BYTES=104857600
MAX_SUBMISSION_BYTES=524288000

# n8n integration. Leave N8N_WEBHOOK_URL empty in dev to disable the trigger
# without erroring at startup; CALLBACK_SECRET is required either way.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
CALLBACK_SECRET=change-me-to-a-64-char-random-string-distinct-from-jwt-and-artifact

# Used to build absolute artifact URLs and the callback URL we hand to n8n.
PUBLIC_API_BASE_URL=http://localhost:8000

# Background cleanup. Defaults match SPEC ("Hourly", 6h artifact TTL, 30 min
# stuck-processing threshold). Set CLEANUP_ENABLED=false to disable the scheduler.
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=60
ARTIFACT_TTL_HOURS=6
STUCK_AFTER_MINUTES=30
