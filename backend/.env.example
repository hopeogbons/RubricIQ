# Local development. Copy to .env and adjust.
DATABASE_URL=postgresql+psycopg://localhost/rubriciq
ENV=development

# Auth
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Superadmin seed (only consulted on first boot when no superadmin exists)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me

# Email (leave RESEND_API_KEY empty in dev to use the no-op email client)
RESEND_API_KEY=
RESEND_FROM_EMAIL=RubricIQ <noreply@rubriciq.com>

# URL the activation email links to
FRONTEND_BASE_URL=http://localhost:5173

# Artifact storage. ARTIFACT_DIR is /data/artifacts on Railway (mounted volume);
# locally point it at any writable directory.
ARTIFACT_DIR=./var/artifacts
ARTIFACT_SIGNING_SECRET=change-me-to-a-64-char-random-string-distinct-from-jwt
MAX_FILE_BYTES=104857600
MAX_SUBMISSION_BYTES=524288000
